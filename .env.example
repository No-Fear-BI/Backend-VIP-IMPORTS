# Copie este arquivo para .env e ajuste se necessario.
# Variaveis do container do banco (docker-compose.yml):
POSTGRES_USER=vip_imports
POSTGRES_PASSWORD=vip_imports
POSTGRES_DB=vip_imports
POSTGRES_PORT=5432

# URL que o Alembic (migracoes/env.py) e a aplicacao (fora do Docker) leem
# do ambiente. Formato: postgresql+psycopg://usuario:senha@host:porta/banco
# Dentro do docker-compose o servico "api" usa outra URL (host "banco"),
# montada direto no docker-compose.yml a partir das variaveis acima.
DATABASE_URL=postgresql+psycopg://vip_imports:vip_imports@localhost:5432/vip_imports

# Variaveis da aplicacao (vip_api/configuracao.py):
AMBIENTE=desenvolvimento
ORIGENS_PERMITIDAS=http://localhost:5173
NIVEL_LOG=INFO
API_PORT=8000
# IPs/CIDRs do proxy (Nginx) que pode ditar X-Forwarded-For. Vazio = ignora
# o cabecalho, que e o certo em desenvolvimento.
PROXIES_CONFIAVEIS=

# Numero da loja no WhatsApp, formato internacional so com digitos.
WHATSAPP_LOJA=554196941824

# E-mails que entram na loja fechada sem aprovacao da equipe (separados por
# virgula). Vazio = ninguem. A identificacao nao tem senha: quem digitar um
# desses e-mails entra.
# EMAILS_PRE_APROVADOS=pessoa@exemplo.com

# Upload de imagem pelo painel (produtos e banners) — disco local, servido
# pela propria API via StaticFiles (ver principal.py). IMAGENS_DIR e' relativo
# ao processo (dentro do container, WORKDIR /app); precisa bater com o volume
# montado em docker-compose.yml. Em producao IMAGENS_URL_BASE PRECISA ser
# https (a API fica atras do Nginx, que e' quem tem o certificado) — http
# aqui derruba a validacao de configuracao.py ao subir com AMBIENTE=producao.
IMAGENS_DIR=./dados/imagens
IMAGENS_URL_BASE=http://localhost:8000/midia

# Usadas SO por scripts/importar_catalogo.py (carga da Fatia 5), nao pela
# aplicacao (vip_api/configuracao.py ignora chave que nao conhece). So
# precisam existir quando o CSV importado tem foto em alguma linha. Ainda
# nao decidimos onde as imagens processadas vao ficar hospedadas de verdade
# — troque os dois valores quando decidir.
CATALOGO_IMAGENS_DIR=./imagens-catalogo
CATALOGO_IMAGENS_URL_BASE=https://cdn.vipimports.com.br/catalogo
